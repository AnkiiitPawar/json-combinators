cabal-version:      2.4
name:               json-combinators
version:            0.1.0.0
synopsis:           A JSON parser built from a small parser-combinator library
description:
  A parser-combinator library over strict ByteString input with committed
  choice and merged error expectations, and an RFC 8259 JSON parser and
  encoder written with it. Numbers are exact decimals.
license:            MIT
license-file:       LICENSE
author:             Ankit Pawar
maintainer:         ankitpawarfinn2209@gmail.com
category:           Text, Parsing, JSON
build-type:         Simple
extra-doc-files:    README.md
tested-with:        GHC ==9.4.7 || ==9.6.7

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4.14 && <5, bytestring >=0.10 && <0.13, text >=1.2 && <2.2

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: JsonCombinators
                   JsonCombinators.Parser
  ghc-options:     -O2

test-suite spec
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:  json-combinators, directory, filepath, QuickCheck >=2.13 && <2.17

benchmark throughput
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is:        Main.hs
  build-depends:  json-combinators
  ghc-options:    -O2 -rtsopts
